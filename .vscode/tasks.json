{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "flash main",
            "type": "shell",
            "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe run -e main && scp .pio/build/main/firmware.uf2 bropi@bropi.local:/tmp/ && ssh bropi@bropi.local \"~/flash_pico.sh\"",
            "options": {
                "cwd": "${workspaceFolder:RC_pico}"
            },
            "problemMatcher": []
        },
        {
            "label": "troll",
            "type": "shell",
            "command": "scp RC_pico/.pio/build/troll/firmware.uf2 bropi@bropi.local:/tmp/ && ssh bropi@bropi.local \"~/flash_pico.sh\"",
            "problemMatcher": [],
            "dependsOn": [
                "PlatformIO: Build (troll)"
            ]
        }
    ]
}
