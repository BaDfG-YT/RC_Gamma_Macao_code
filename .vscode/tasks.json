{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "envName",
      "type": "pickString",
      "description": "Какое окружение прошить?",
      "options": ["main", "troll", "moving", "read_uart"],
      "default": "main"
    }
  ],
  "tasks": [
    {
      "label": "Flash",
      "type": "shell",
      "command": "python3 \"${workspaceFolder:RC}/scripts/flash.py\" ${input:envName}",
      "problemMatcher": []
    }
  ]
}